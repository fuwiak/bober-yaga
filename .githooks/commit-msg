#!/usr/bin/env bash
# Enforce pandas-style commit prefixes; block tool/agent attribution.
set -euo pipefail

MSG_FILE="${1:?commit message file required}"
SUBJECT="$(sed -n '1p' "$MSG_FILE" | tr -d '\r')"

# Strip empty / comment-only subjects after template
if [[ -z "$SUBJECT" || "$SUBJECT" =~ ^# ]]; then
  echo "commit-msg: empty subject" >&2
  exit 1
fi

# Forbidden: tool / agent branding in subject or body
if grep -Eiq \
  'cursor|codex|copilot|chatgpt|claude\.ai|generated by (an? )?ai|co-authored-by:.*(cursor|codex|copilot|openai|anthropic)' \
  "$MSG_FILE"; then
  echo "commit-msg: remove Cursor/Codex/Copilot/AI attribution from the commit message" >&2
  echo "  (no tool names, no Co-authored-by for agents)" >&2
  exit 1
fi

# Allow merge / revert / release tags without TYPE:
if [[ "$SUBJECT" =~ ^(Merge|Revert|Release) ]]; then
  exit 0
fi

PREFIX_RE='^(ENH|BUG|PERF|REF|BLD|CI|DOC|TST|STY|API|DIST|MAINT|WEB|TYP|SEC): .+'
if ! [[ "$SUBJECT" =~ $PREFIX_RE ]]; then
  cat >&2 <<'EOF'
commit-msg: subject must start with a pandas-style type prefix.

  ENH:  BUG:  PERF:  REF:  BLD:  CI:  DOC:  TST:  STY:  API:  DIST:  MAINT:

Example:
  ENH: add Audience brick for segment sync

See .gitmessage and CONTRIBUTING.md
EOF
  exit 1
fi

# Soft length check on subject
if (( ${#SUBJECT} > 72 )); then
  echo "commit-msg: subject is ${#SUBJECT} chars (prefer ≤72)" >&2
  exit 1
fi

exit 0
